DATABASE_URL=postgresql+asyncpg://coastguard:CHANGE_ME@acrossthe.cloud:5432/coastguard
DEFAULT_EVENT_ID=5
# LiteLLM model string. Local Ollama: ollama/qwen2.5:3b. Hosted later, e.g.
# groq/llama-3.1-8b-instant (plus LLM_API_KEY below). Swap = one-line change.
LLM_MODEL=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Bearer key for hosted providers. Leave empty for local Ollama.
LLM_API_KEY=
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.2

# Accounts: OAuth 2.0 (authorization code + PKCE). Set JWT_SECRET plus the credentials of at least one provider; each provider with both
# an id and a secret gets a sign-in button. Client SECRETS are confidential: put them only here (git-ignored .env), never in chat or code.
# Redirect / callback URL to register at the provider: <APP_ORIGIN>/api/auth/<provider>/callback
#   GitHub: github.com > Settings > Developer settings > OAuth Apps > New. Callback: http://localhost:5173/api/auth/github/callback
#   Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web). Redirect URI: http://localhost:5173/api/auth/google/callback
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No SMTP_HOST: alert emails are written to backend/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LIVE_ALERT_POLL_S=600
