DATABASE_URL=postgresql+asyncpg://coastguard:CHANGE_ME@acrossthe.cloud:5432/coastguard
DEFAULT_EVENT_ID=5
# LiteLLM model string. Local Ollama: ollama/qwen2.5:3b. Hosted later, e.g.
# groq/llama-3.1-8b-instant (plus LLM_API_KEY below). Swap = one-line change.
LLM_MODEL=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Bearer key for hosted providers. Leave empty for local Ollama.
LLM_API_KEY=
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.2

# Accounts: Google OAuth 2.0 (authorization code + PKCE). On only when JWT_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are all set.
# This file is TRACKED by git: keep every value blank here. Real values (above all the client SECRET) go only in the git-ignored backend/.env.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Authorised redirect URI: <APP_ORIGIN>/api/auth/google/callback
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No SMTP_HOST: alert emails are written to backend/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LIVE_ALERT_POLL_S=600
