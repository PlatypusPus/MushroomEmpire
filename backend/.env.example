DATABASE_URL=postgresql+asyncpg://coastguard:CHANGE_ME@acrossthe.cloud:5432/coastguard
DEFAULT_EVENT_ID=5
# LiteLLM model string. Local Ollama: ollama/qwen2.5:3b. Hosted later, e.g.
# groq/llama-3.1-8b-instant (plus LLM_API_KEY below). Swap = one-line change.
LLM_MODEL=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Bearer key for hosted providers. Leave empty for local Ollama.
LLM_API_KEY=
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.2

# Accounts (Google sign-in + alert emails). Accounts stay disabled until JWT_SECRET and GOOGLE_CLIENT_ID are both set.
# GOOGLE_CLIENT_ID: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Authorised JS origin: http://localhost:5173
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=
JWT_SECRET=
# No SMTP_HOST: alert emails are written to backend/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LIVE_ALERT_POLL_S=600
